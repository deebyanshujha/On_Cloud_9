# Copy this file to .env and fill in real values. .env is gitignored.

# Required to enable the Phase 4 LLM interpretation layer
# (app/core/llm_interpreter.py). Leaving it unset disables the layer
# cleanly — case analysis works fully without it.
GEMINI_API_KEY=

# Optional overrides (see app/core/config.py for defaults):
# ARB_LLM_MODEL=gemini-2.5-flash
# ARB_LLM_MAX_TOKENS=600
# ARB_LLM_TIMEOUT_SECONDS=20
# ARB_LLM_MAX_CANDIDATES=5
# ARB_ENABLE_LLM_INTERPRETATION=true
